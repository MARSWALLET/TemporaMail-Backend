NODE_ENV=development
PRIMARY_DOMAIN=temporamail.app
MAIL_HOSTNAME=mail.temporamail.app
ALLOWED_DOMAINS=temporamail.app
SMTP_PORT=2525
API_PORT=3000
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://temporamail:password@localhost:5432/temporamail
RSPAMD_URL=http://localhost:11334
DNS_RESOLVER=127.0.0.1
DEFAULT_TTL_MINUTES=10
MAX_TTL_MINUTES=60
MAX_MESSAGE_BYTES=10485760
MAX_MESSAGES_PER_INBOX=50
SMTP_MAX_CLIENTS=100
SMTP_MAX_CONNECTIONS_PER_IP=5
SMTP_MAX_RECIPIENTS=5
SMTP_MAX_MESSAGES_PER_MIN=10
RSPAMD_REJECT_SCORE=15
RSPAMD_FLAG_SCORE=6
DNSBL_ZONES=zen.spamhaus.org,bl.spamcop.net
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_RATE_LIMIT_PER_MIN=120
INBOX_CREATE_LIMIT_PER_HOUR=10
TURNSTILE_SECRET=
ADMIN_API_KEY=
TLS_KEY_PATH=
TLS_CERT_PATH=
APP_BASE_URL=http://localhost:3001
SMTP_OUTBOUND_HOST=
SMTP_OUTBOUND_PORT=587
SMTP_OUTBOUND_SECURE=false
SMTP_OUTBOUND_USER=
SMTP_OUTBOUND_PASS=
SMTP_OUTBOUND_FROM=TemporaMail <noreply@account.temporamail.app>
