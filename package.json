{
  "name": "temporamail-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:smtp": "tsx watch src/smtp/index.ts",
    "dev:api": "tsx watch src/api/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start:smtp": "node dist/smtp/index.js",
    "start:api": "node dist/api/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "ioredis": "^5.6.0",
    "mailauth": "^8.1.0",
    "mailparser": "^3.15.0",
    "pino": "^9.6.0",
    "sanitize-html": "^2.18.2",
    "smtp-server": "^3.13.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.13.10",
    "@types/sanitize-html": "^2.16.2",
    "@types/smtp-server": "^3.5.13",
    "ioredis-mock": "^8.9.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
